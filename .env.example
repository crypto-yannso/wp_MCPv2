# WordPress Configuration
WP_URL=https://example.com/xmlrpc.php
WP_USERNAME=admin
WP_PASSWORD=your_password

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Demo Mode Configuration
# Set to "false" to disable demo mode and use real WordPress connection
MCP_DEMO_MODE=false
# Set to "false" to prevent fallback to demo mode
MCP_ALLOW_DEMO_MODE=false